# Public GitHub username used by the portfolio API
GITHUB_USERNAME=PrajyotXDev

# Optional GitHub token for higher API rate limits.
# Never commit a real token.
GITHUB_TOKEN=

# Contact destination used by the mail provider integration.
CONTACT_TO=

# Resend API key. Leave blank to keep contact delivery disabled.
RESEND_API_KEY=

# The address/name shown as the sender by Resend.
CONTACT_FROM=Portfolio <onboarding@resend.dev>
