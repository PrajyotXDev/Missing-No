# Public URL of the deployed site (used for metadata, Open Graph and the sitemap).
NEXT_PUBLIC_SITE_URL=

# Contact form delivery through Resend (https://resend.com).
# Leave RESEND_API_KEY or CONTACT_TO blank and the form composes a message
# in the visitor's own mail app instead of sending from the server.
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=Portfolio <onboarding@resend.dev>
